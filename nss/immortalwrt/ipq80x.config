CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-partexp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wolultra-zh-cn=y

#
# ============================================================
# Network / 网络功能
# ============================================================
#

CONFIG_PACKAGE_curl=y

# FullCone SONiC
CONFIG_PACKAGE_fullconenat-sonic=y

# UPnP / NFT
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_nftables-json=y

# 局域网服务
CONFIG_PACKAGE_avahi-dbus-daemon=y
CONFIG_PACKAGE_knot-resolver_dnstap=y
CONFIG_PACKAGE_wsdd2=y

# 网络工具
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_openssh-keygen=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_cgi-io=y

# HomeProxy / Sing-box
CONFIG_PACKAGE_sing-box=y

# Web
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# Wi-Fi
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpad-openssl=y

# IPv6 / 网络唤醒
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_ethtool=y

# GeCoosAC / 性能测试
CONFIG_PACKAGE_gecoosac=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_iw=y

# NatMapT / Stuntman
CONFIG_PACKAGE_natmapt=y
CONFIG_PACKAGE_stuntman-client=y

# DHCP / PPP
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# Bonding
CONFIG_PACKAGE_proto-bonding=y

# Samba4
CONFIG_PACKAGE_samba4-libs=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_SAMBA4_SERVER_WSDD2=y
CONFIG_SAMBA4_SERVER_NETBIOS=y
CONFIG_SAMBA4_SERVER_AVAHI=y
CONFIG_SAMBA4_SERVER_VFS=y

# 下载
CONFIG_PACKAGE_uclient-fetch=y

#
# ============================================================
# Utilities / 系统工具
# ============================================================
#

CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_xz-utils=y

# 磁盘 / 分区
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_cgdisk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_nvme-cli=y
CONFIG_PACKAGE_parted=y
CONFIG_PARTED_READLINE=y
CONFIG_PACKAGE_sfdisk=y
CONFIG_PACKAGE_sgdisk=y

# 文件系统
CONFIG_PACKAGE_attr=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_resize2fs=y

# Shell / 基础工具
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_bc=y

# CoreMark
CONFIG_PACKAGE_coremark=y
CONFIG_COREMARK_OPTIMIZE_O3=y
CONFIG_COREMARK_ENABLE_MULTITHREADING=y

# Coreutils
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-timeout=y

# 系统工具
CONFIG_PACKAGE_dbus=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_flock=y
CONFIG_PACKAGE_jshn=y
CONFIG_PACKAGE_libjson-script=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_openssl-util=y

# LPAC / Modem
CONFIG_LPAC_WITH_PCSC=y
CONFIG_LPAC_WITH_AT=y
CONFIG_LPAC_WITH_UQMI=y
CONFIG_LPAC_WITH_MBIM=y

CONFIG_PACKAGE_qmodem_INCLUDE_SEAL=y
CONFIG_PACKAGE_qmodem_INCLUDE_ndisc6=y
CONFIG_PACKAGE_qmodem_INCLUDE_vendor-qmi-wwan=y
CONFIG_PACKAGE_qmodem_USE_TOM_CUSTOMIZED_QUECTEL_CM=y

# 其他工具
CONFIG_PACKAGE_shellsync=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_smartmontools-drivedb=y
CONFIG_STRACE_NONE=y

# TAR
CONFIG_PACKAGE_TAR_POSIX_ACL=y
CONFIG_PACKAGE_TAR_XATTR=y
CONFIG_PACKAGE_TAR_BZIP2=y
CONFIG_PACKAGE_TAR_GZIP=y
CONFIG_PACKAGE_TAR_XZ=y
CONFIG_PACKAGE_TAR_ZSTD=y

# TOM Modem
CONFIG_PACKAGE_tom_modem_EARLY_RETURN=y
CONFIG_PACKAGE_tom_modem_ENABLE_UBUS_DAEMON=y

# UBI / NAND
CONFIG_PACKAGE_ubi-utils=y

# USB 工具
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usbids=y
CONFIG_PACKAGE_usbutils=y
